--- !u!114 &1885261935
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1885261934}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe16c5afa4916814b86aab10fcf795de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HazardDialogue
  hazardName: Devices Left ON
  lines:
  - text: "Look at this \u2014 computers and equipment left running with nobody around."
    characterPose: {fileID: 21300000, guid: 1df00db9a1101574d87e2b5df19761c5, type: 3}
    demoVideo: {fileID: 0}
  - text: Electronics still draw power when idle, and they keep generating heat with
      no one there to notice.
    characterPose: {fileID: 21300000, guid: 6dabcd07478f38b4384467fb682f154c, type: 3}
    demoVideo: {fileID: 0}
  - text: "Overnight, a faulty charger or worn cable can overheat for hours before
      anyone finds out. Many office fires start exactly this way \u2014 after everyone
      has gone home."
    characterPose: {fileID: 21300000, guid: 6dabcd07478f38b4384467fb682f154c, type: 3}
    demoVideo: {fileID: 0}
  - text: A device that's switched off can't overheat. That's why the last person
      out matters so much.
    characterPose: {fileID: 21300000, guid: 6dabcd07478f38b4384467fb682f154c, type: 3}
    demoVideo: {fileID: 0}
  - text: 'Safety action: Practice checking all devices before leaving the office.
      Switch them off at the source. Tap the power button to turn this one off.'
    characterPose: {fileID: 21300000, guid: dc86be78c176b7249911c3e5eec98bf6, type: 3}
    demoVideo: {fileID: 0}
  completionLines:
  - text: Well done. Everything's powered down properly.
    characterPose: {fileID: 21300000, guid: dc86be78c176b7249911c3e5eec98bf6, type: 3}
    demoVideo: {fileID: 0}
  - text: 'Powered down safely. That''s how every workstation should be left.

'
    characterPose: {fileID: 21300000, guid: 2cb2c185d83af914aa26b4c0fb08c86f, type: 3}
    demoVideo: {fileID: 0}
  actionTarget: {fileID: 1627924066}
  isComplete: 0
