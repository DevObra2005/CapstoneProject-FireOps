--- !u!114 &12180333
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 12180331}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abc4fb93ea8be674ab892f897882597b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Phase2Briefing
  briefingLines:
  - text: "This is the simulation. Everything I taught you, you use now. Look \u2014
      there is a fire."
    characterPose: {fileID: 21300000, guid: 1df00db9a1101574d87e2b5df19761c5, type: 3}
    demoVideo: {fileID: 0}
  - text: That is what octopus wiring becomes when nobody acts on it. Overheated
      cords, then flames.
    characterPose: {fileID: 21300000, guid: 6dabcd07478f38b4384467fb682f154c, type: 3}
    demoVideo: {fileID: 0}
  - text: Show me the proper way to use the extinguisher, exactly as I taught you.
      Put the fire out, then get to the door. Ninety seconds, starting now.
    characterPose: {fileID: 21300000, guid: 1df00db9a1101574d87e2b5df19761c5, type: 3}
    demoVideo: {fileID: 0}
  startDelay: 1
