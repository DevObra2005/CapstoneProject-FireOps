  m_Script: {fileID: 11500000, guid: f4799f8d29cd2fc4bac887f9964782bc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Phase1Brifier
  briefingLines:
  - text: Good day. I am an officer of the Bureau of Fire Protection, Natividad Station.
      Today we will cover how to identify fire hazards before they cause harm.
    characterPose: {fileID: 21300000, guid: 2cb2c185d83af914aa26b4c0fb08c86f, type: 3}
    demoVideo: {fileID: 0}
  - text: This office has two of common hazards Look around, and tap anything you
      think is a risk.
    characterPose: {fileID: 21300000, guid: 6dabcd07478f38b4384467fb682f154c, type: 3}
    demoVideo: {fileID: 0}
  - text: When you find one, I will explain what it is and what to do about it. Take
      your time.
    characterPose: {fileID: 21300000, guid: 2cb2c185d83af914aa26b4c0fb08c86f, type: 3}
    demoVideo: {fileID: 0}
  startDelay: 1
