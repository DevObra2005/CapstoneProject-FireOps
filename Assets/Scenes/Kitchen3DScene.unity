  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HazardDialogue
  hazardName: Octopus Wiring
  lines:
  - text: Rubber LPG hoses harden and crack with age, heat and cooking oil exposure.
      A cracked hose leaks gas that pools near the stove, where any spark can ignite
      it.
    characterPose: {fileID: 0}
    demoVideo: {fileID: 0}
  - text: Do not attempt to repair a gas line yourself. Report it and have it replaced
      by a qualified technician.
    characterPose: {fileID: 0}
    demoVideo: {fileID: 0}
  completionLines:
  - text: Regular checking of the hose and regulator catches wear before it becomes
      a leak.
    characterPose: {fileID: 0}
    demoVideo: {fileID: 0}
  actionTarget: {fileID: 0}
  isComplete: 0
